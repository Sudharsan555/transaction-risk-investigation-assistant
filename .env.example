# NexusTiQ24 - Transaction Risk Investigation Assistant (TRACK_ID=PS06)
# Environment Variables Template
# ====================================================================

# Google Gemini API Key (Required for live GenAI reasoning reports)
# If omitted or unavailable, system automatically runs high-speed deterministic fallback
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Gemini Models (Compatible with Google GenAI SDK generateContent)
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
